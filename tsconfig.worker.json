{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": [
    "src/loader/stepLoader.worker.ts",
    "src/loader/occt-import-js.d.ts",
    "src/loader/types.ts",
    "src/sim/geometry/buildSignedDistanceField.worker.ts",
    "src/sim/geometry/buildSignedDistanceField.ts",
    "src/sim/geometry/signedDistanceField.ts",
    "src/sim/geometry/sdfWorkerTypes.ts",
    "src/sim/geometry/triangleDistance.ts",
    "src/sim/core/types.ts"
  ]
}
